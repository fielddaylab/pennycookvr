#basePath	Day1

:: Prepare
@function	ScenePrepare
$call PlaceAndRotatePlayerAt(WarpDesk, true)
$call SetAllWarpsActive(false)

:: StartGame
@trigger    SceneReady
@who        Player
@once

$set global:level = 1

$call Wait(2)

{@Player}   Wow, I can't believe I'm finally here!  $[Day1/Tent/Player_1]

{@Player}   Brr. Lola was right though... I should've packed an extra sweater.   $[Day1/Tent/Player_2]
{@Player}   Alright, time to get focused. Those penguins aren’t gonna research themselves. $[Day1/Tent/Player_3]
{@Player}   Step one: Find research tent. Check.    $[Day1/Tent/Player_4]
{@Player}   Step two: Report to Margo, penguin expert and senior researcher.    $[Day1/Tent/Player_5]
{@Player}   Hmmm. But where is she?     $[Day1/Tent/Player_6]

:: PickedUpMargo
@trigger    TabletLifted
@who        Player
@interrupt
@once

$call Wait(1)
$set	chapter:hasTalkedToMargo = true

{@Margo}    Oh, hiya! Welcome to the South Pole, kid!   $[Day1/Tent/Margo_1]
{@Player}   Oh, uh… I’m not a kid. I’m the new junior researcher.  $[Day1/Tent/Player_7]
{@Margo}    Uh, yah, like I said!   $[Day1/Tent/Margo_2]
{@Margo}    And just in time, too.   $[Day1/Tent/Margo_3]
{@Margo}    Spring is in the air… lotsa penguins out there lookin’ for love.   $[Day1/Tent/Margo_4]
{@Margo}    It’ll be great to have ya on the team.   $[Day1/Tent/Margo_5]
{@Player}   Your team?  $[Day1/Tent/Player_8]
{@Margo}    I’m Margo, the penguin research coordinator.  $[Day1/Tent/1tm06]
{@Margo}    Nice to meet ya!    $[Day1/Tent/Margo_7]
{@Player}   You're Margo?  $[Day1/Tent/Player_9]
{@Margo}    Well, yah, last I checked.  $[Day1/Tent/Margo_8]
{@Margo}    What’s wrong? Do I got cookies stuck in my teeth or somethin’?  $[Day1/Tent/Margo_9]
{@Margo}    Aw, relax, kiddo, I’m jokin’. Just a little data humor for ya.  $[Day1/Tent/Margo_10]
{@Player}   I've heard about you. You're one of the leading penguin researchers in the world... I had no idea you were a tablet.   $[Day1/Tent/Player_10]
{@Margo}	Aw, that's okay, kiddo. Lotsa people make that mistake. $[Day1/Tent/1tm10a]
{@Margo}	I've been told I'm pretty social, for a tablet. And a great cook, too.  $[Day1/Tent/1tm10b]
{@Margo}    Feel free to have yerself a look around! This'll be our den for the season.   $[Day1/Tent/Margo_11]
{@Margo}    Couldja peek out the front door with me? I can't wait to see who's here! $[Day1/Tent/Margo_12]
{@Margo}    Let's skedaddle! Use "Warp" to find the waypoint outside!   $[Day1/Tent/Margo_13]

$call CreateGoal("day1_outside", Use Warp to go outside)
$call SetWarpActive(WarpBluff, true)

:: WarpedOutsideTent
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-Bluff"
@once

$call TentDoor->Close()

$call CompleteGoal("day1_outside")

$call Wait(1)

$call SetWarpActive(WarpBluff, false)

$call PenguinCount->ActivateCount(12)

{@Margo}    Let's get started. Your first job is pretty simple. $[Day1/Bluff/1bm01]
{@Margo}    We need a population count from up here on the Bluff. $[Day1/Bluff/1bm02]
{@Player}	A population count? $[Day1/Bluff/1bs01]
{@Player} Okay. No problem. I can handle this. $[Day1/Bluff/1bs02]
{@Player} Uno, dos, tres, cuatro... $[Day1/bluff/1bs03]
{@Margo}    Hold up kiddo.  You don't have to count them. $[Day1/Bluff/1bm03]
{@Margo}    That's what I'm here for. $[Day1/Bluff/1bm04]
{@Margo}    Just turn on Count Mode and point me at the colony. $[Day1/Bluff/1bm05]
{@Margo}    I'll collect all the data! $[Day1/Bluff/1bm06]
{@Player}	Oh! $[Day1/Bluff/1bs04]
{@Player} Uh, obviously.  I knew that. $[Day1/Bluff/1bs05]
{@Margo}    Uh huh. Sure ya did. $[Day1/Bluff/1bm07]

$call CreateGoal("day1_count", Use Count to count population)


:: ScannedFromBluff
@trigger	TabletCounted
@who		Player
@interrupt
@once

$call CompleteGoal("day1_count")

{@Margo}	Nice work, kiddo! We've got our initial population count. $[Day1/Bluff/1bm08]
{@Partner}  Oh, hey there new guy! I see you've met Margo. I'm Penny.   $[Day1/Bluff/Partner_1]
{@Player}	On wow! This is such an honor. I've read all your research on climate change and penguin migration. $[Day1/Bluff/1bs06]
{@Player}	I remember when you talked to my 5th grade class at Gompers Elementary. $[Day1/Bluff/1bs07]
{@Partner}	Hmm. That would've been, what, 12 or 13 years ago?	$[Day1/Bluff/Partner_2]
{@Partner}	15, I think.	$[Day1/Bluff/Partner_3]
{@Margo}	Okay, kiddo, enough yammerin'. Time for your next task. 	$[Day1/Bluff/1bm09]
{@Margo}	You’ve been assigned five penguins to keep a special eye on this season. 	$[Day1/Bluff/1bm10]
{@Margo}	Let's get on down there and say hello! Find a waypoint in the rookery. 	$[Day1/Bluff/1bm11]

$call CreateGoal("day1_rookery", Use Warp to enter rookery)
$call SetWarpGroupActive(Rookery, true)

:: WarpedToRookery
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-Rookery"
@once

$call CompleteGoal("day1_rookery")

$call Wait(1)

$call SetWarpGroupActive(Rookery, true)

$call ClearGoals()

$call CreateGoal("band_red", Scan penguin with red band)
$call CreateGoal("band_yellow", Scan penguin with yellow band)
$call CreateGoal("band_green", Scan penguin with green band)
$call CreateGoal("band_blue", Scan penguin with blue band)
$call CreateGoal("band_purple", Scan penguin with purple band)

//$call Daisy->SetInteractable(false)
//$call Meatball->SetInteractable(false)
//$call Billy->SetInteractable(false)
//$call Benni->SetInteractable(false)
//$call Wendy->SetInteractable(false)

{@Player}	Hah! I can't wait to meet them. I wish Lola was here to see this.	$[Day1/Rookery/1rs01]
{@Margo}	Who's that now?	$[Day1/Rookery/1rm01]
{@Player}	Oh, Lola is my girlfriend. She loves birds too!	$[Day1/Rookery/1rs02]
{@Player}	But I think she’s happier staying where the sun sets every night like it’s supposed to.	$[Day1/Rookery/1rs03]
{@Margo}	Wow. Every night! That must really be somethin.	$[Day1/Rookery/1rm02]
{@Margo}	Doown here, we only get one sunrise and one sunset every year.	$[Day1/Rookery/1rm03]
{@Margo}	Anywho, let's get to work.	$[Day1/Rookery/1rm04]
{@Margo}	Remember, you're just looking for five adult penguins with trackers on their wings.	$[Day1/Rookery/1rm05]
{@Player}	How do I scan them?	$[Day1/Rookery/1rs04]
{@Margo}	Just hold me up in front of each penguin.	$[Day1/Rookery/1rm06]
{@Margo}	Then use "Interact" to scan!	$[Day1/Rookery/1rm07]
{@Margo}	I’ll ID them and collect their data.	$[Day1/Rookery/1rm08]
			
:: OnPenguinIdentified
@function	TabletIdentified
@when		objectType == "BandedPenguin"
$set	chapter:identifiedCount + 1

$if local:objectId == "RedAdelie"
	$call CompleteGoal("band_red")
	{@Margo}	Aw, Millie’s back! She had chicks for the first time last year. Great mom, too.	$[Day1/Rookery/1rm09]
	{@Margo}	A little strict, maybe. But neither of her chicks got eaten by skua, so that’s always a good sign.	$[Day1/Rookery/1rm10]
$elseif local:objectId == "YellowAdelie"
	$call CompleteGoal("band_yellow")
	{@Margo}	Oh, I'm so glad Polo made it back! He is my favorite. Such a cutie.	$[Day1/Rookery/1rm15]
	{@Player}	Are you sure we should be picking favorites?	$[Day1/Rookery/1rs05]
	{@Player}	I thought scientists were supposed to be objective.	$[Day1/Rookery/1rs06]
	{@Margo}	Oh, don’t worry. I’m totally objective.	$[Day1/Rookery/1rm16]
	{@Margo}	Polo is objectively the cutest penguin you’ll ever meet.	$[Day1/Rookery/1rm17]
$elseif local:objectId == "GreenAdelie"
	$call CompleteGoal("band_green")
	{@Margo}	Aw, good old Winston. $[Day1/Rookery/1rm18]
	{@Margo}	We can always count on him to make an appearance. $[Day1/Rookery/1rm19]
$elseif local:objectId == "BlueAdelie"
	$call CompleteGoal("band_blue")
	{@Margo}	Ooh, Alfredo’s back! I haven’t seen her since she was a chick.	$[Day1/Rookery/1rm11]
	{@Player}	Alfredo? Why does that sound familiar?	$[Day1/Rookery/1rs08]
	{@Margo}	Oh, I’m sure you know her. She’s internet famous.	$[Day1/Rookery/1rm12]
	{@Margo}	Penny used to keep her page updated. Alfredo’s baby videos got two billion views!	$[Day1/Rookery/1rm13]
	{@Player}	Billion?? Like, with a B?	$[Day1/Rookery/1rs09]
$elseif local:objectId == "PurpleAdelie"
	$call CompleteGoal("band_purple")
	{@Margo}	Aw, it’s Fuzz! I remember him. His hair was crazy when he was growing. 	$[Day1/Rookery/1rm14]
$endif

$if chapter:identifiedCount >= 5
	$set chapter:allIdentified = true
	{@Margo}	Great work kid! You've got your 5 penguins, $[Day1/Rookery/1rm20]
	{@Player}	Awesome. The Fantastic Five!	$[Day1/Rookery/1rs10]
	{@Player}	Or . . . the Fintastic Five. Los Cinco Fintasticos?	$[Day1/Rookery/1rs11]
	{@Margo}	Yikes. You are new, huh? Penguins have flippers, not fins.	$[Day1/Rookery/1rm21]
	{@Player}	Let's head back. It's freezing out here! 	$[Day1/Rookery/1rs12]
	$call TriggerResponse(ObjectiveCompleted)
$endif

:: ObjectiveCompleted
@trigger	ObjectiveCompleted
@who		Player
@once
@interrupt

$set	chapter:finishedObservations = true
$call ClearGoals()

$call Wait(0.3)
$call SetWarpActive(WarpBluffBack, true)

$call CreateGoal("day1_return", Return to tent)

:: WarpedBackToTent
@trigger    AtWarpPoint
@who        Player
@when       chapter:finishedObservations, targetObject == "WarpTarget-Bluff-Back"
@once

$call Wait(1)

$call SetWarpActive(WarpBluffBack, false)
$call SetWarpGroupActive(Rookery, false)
$call SetWarpActive(WarpDesk, true)

$call CreateGoal("day1_upload", Upload Margo's data)

:: WarpedInsideTent
@trigger    AtWarpPoint
@who        Player
@when       chapter:finishedObservations, targetObject == "WarpTarget-Desk"
@interrupt

$call CompleteGoal("day1_return")
$call Wait(1)
$call SetWarpActive(WarpDesk, true)

{@Margo}    Okay, let's have a look at that data!  $[Day1/Tent/1tm14]
{@Margo}    Dock me in the port by the computer over yonder.   $[Day1/Tent/1tm15]

$while !IsSocketedBy(DeskDock, Margo)
$call Wait(0.5)
$endwhile

{@Player}   There ya go. Safe and sound.   $[Day1/Tent/1ts01]
{@Player}   And now the big ole button! $[Day1/Tent/Player_12]

$while !ButtonPressed(BigButton)
$call Wait(0.5)
$endwhile

$call CompleteGoal("day1_upload")

{@Margo}    Looks like we've got 1527 returners! Mostly adults, and a few subadults.    $[Day1/Tent/1tm16]
{@Margo}    Your cohort includes five penguins, two females and three males.    $[Day1/Tent/1tm17]
{@Margo}	Alfredo, Fuzz, and Polo are all back for the first time since they were chicks.	$[Day1/Tent/1tm18]
{@Margo}	They look healthy, though Fuzz is a little small for his age... hopefully he'll pack on a few pounds now that he's back home. 	$[Day1/Tent/1tm19]
{@Margo}	This is the first mating season for all three of them.	$[Day1/Tent/1tm20]
{@Margo}	Millie's back for the second time. No signs of illness or malnutrition. 	$[Day1/Tent/1tm21]
{@Margo}	And there's Winston, back for his sixth mating season!  	$[Day1/Tent/1tm22]
{@Margo}	He's gettin' on in years, but still in good health. A great dad, too.   	$[Day1/Tent/1tm23]
{@Margo}	Great first day, kiddo! Get some rest now, why don'tcha?  	$[Day1/Tent/Margo_16]
{@Margo}	We'll get back at it bright and early tomorrow.  	$[Day1/Tent/1tm25]
{@Player}	Isn't it always bright here? 	$[Day1/Tent/1ts02]
{@Margo}	Yep. Pro tip: invest in a good sleep mask.   	$[Day1/Tent/1tm26]
{@Margo}	See ya tomorrow, kid!   	$[Day1/Tent/1tm27]

$call FadeOut(1.0)
$call Wait(2)

$call LoadNextDay()
 