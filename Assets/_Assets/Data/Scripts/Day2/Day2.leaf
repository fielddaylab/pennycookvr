#basePath	Day2

:: Prepare
@function	ScenePrepare
$set chapter:identifiedCount = 0
$set chapter:finishedAllObservations = false
$set chapter:finishedObservations = false
$call ClearGoals()
$call PlaceAndRotatePlayerAt(WarpDesk, true)
$call SetAllWarpsActive(false)
$call DayHeader->SetText(Nov 16)
$call GPSTrackerPlate->Activate()
$call Sky1->Deactivate()
$call Sky2->Activate()
$call Sky2->SetSkybox()
$call Ocean->SetMaterial(1);

$call FadeIn(2.0)
$call Wait(2)

:: StartGame
@trigger    SceneReady
@who        Player
@once

$call CreateGoal("Day2_outside", Warp outside)
$call SetWarpActive(WarpBluff, true)

{@Margo}   Mornin', kiddo!   $[Day2/Tent/2tm01]
{@Margo}   Jeepers... you look exhausted.   $[Day2/Tent/2tm02]
{@Player}   I couldn't sleep. I tried counting sheep, counting penguins, stress-eating candy bars . . .   $[Day2/Tent/Player_2]
{@Margo}   Just wait til you spend a few days runnin' around after penguins. You'll be so tired you won't know what hit ya.     $[Day2/Tent/2tm04]

:: PickedUpMargo2
@trigger    TabletLifted
@who        Player
@interrupt
@once

$call Wait(1)

{@Player}    Sounds good to me. Let's get out there!   $[Day2/Tent/Player_3]
{@Margo}    Got your cold weather gear on?   $[Day2/Tent/2tm06]
{@Player}    All five layers of it. Plus some extra hand warmers.    $[Day2/Tent/Player_4]
{@Margo}    Well, okey dokey, then. Looks like somebody's learnin'.  $[Day2/Tent/2tm08]
{@Margo}    Whenever you're ready, point me at the door, and we'll head out to the Bluff!     $[Day2/Tent/2tm09]


:: WarpedOutsideTent2
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-Bluff"
@interrupt
@once

$call CompleteGoal("Day2_outside")

$call Wait(1)

$call SetWarpActive(WarpBluff, false)

$call TentDoor->Close()

$call PenguinCount->ActivateCount(12)

{@Player}    Wow, look at them all! $[Day2/Bluff/Player_1]
{@Margo}    Yep, seems we've got some new arrivals. We'll need a new population count. $[Day2/Bluff/2bm01]
{@Margo}    You’ll also have two tasks down at the Rookery: retrieve your penguins’ GPS trackers, and see if they’ve paired up with a mate. $[Day2/Bluff/2bm02]
{@Player}   Hmmm, Maybe we should get a head count. $[Day2/Bluff/Player_3]

$call CreateGoal("Day2_count", Count the penguin population)

:: ScannedFromBluff2
@trigger	TabletCounted
@who		Player
@interrupt
@once

$call CompleteGoal("Day2_count")

{@Margo}  Great job, kid! We’ve got a new population count.  $[Day2/Bluff/2bm04]

$call SetWarpGroupActive(Rookery, true)
$call CreateGoal("Day2_rookery", Warp inside rookery)

:: WarpedToRookery2
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-Rookery"
@once

$call ClearGoals()
$call CreateGoal("Day2_trackers", Retrieve 3 gps trackers from penguins)
$call CreateGoal("Day2_mates", Identify the mates of the banded penguins)

$call Wait(1)

:: WarpedToRookeryMiddle2
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-RookeryMiddle"
@once

$call Wait(2)

$call ClearGoals()

$call Daisy->SetInteractable(true)
$call Meatball->SetInteractable(true)
$call Billy->SetInteractable(true)
$call Benni->SetInteractable(true)
$call Wendy->SetInteractable(true)

$call Daisy->SetIdentified(false)
$call Meatball->SetIdentified(false)
$call Billy->SetIdentified(false)
$call Benni->SetIdentified(false)
$call Wendy->SetIdentified(false)

$call CreateGoal("id_millie", ID Millie's Mate)
$call CreateGoal("id_alfredo", ID Alfredo's Mate)
$call CreateGoal("id_fuzz", ID Fuzz's Mate)
$call CreateGoal("id_winston", ID Winston's Mate)
$call CreateGoal("id_polo", ID Polo's Mate)

{@Margo}   Okey dokey. Time to track down the Funtastic Five $[Day2/Rookery/2rm01]
{@Player}  The Fliptastic Five. $[Day2/Rookery/Player_1]
{@Margo}    And get an ID on their mates. $[Day2/Rookery/2rm02]
{@Player}   How can I tell who their mates are? $[Day2/Rookery/Player_2]
{@Margo}    You will need to look for the mating dances.    $[Day2/Rookery/2rm03]
{@Player}   Oh. Right. Got it.  $[Day2/Rookery/Player_3]

:: OnBillyIdentified
@trigger	TabletIdentified
@when		objectId == "Billy"
@once
@interrupt

$set	chapter:identifiedCount + 1
$call CompleteGoal("id_millie")

{@Player}   Looks like Millie paired up with her same mate from last year!  $[Day2/Rookery/Player_4]
{@Partner}  Millie and . . . Billy? $[Day2/Rookery/Partner_1]
{@Partner}  Hey, you try coming up with names for hundreds of penguins each year. You run out of ideas real quick.  $[Day2/Rookery/Partner_2]

$goto Day2.CheckAllMatesIdentified

:: OnMeatballIdentified
@trigger	TabletIdentified
@when		objectId == "Meatball"
@once
@interrupt

$set	chapter:identifiedCount + 1
$call CompleteGoal("id_alfredo")

{@Margo}    Hmmm. Alfredo’s mate doesn’t have a tag. Looks like a newbie.   $[Day2/Rookery/2rm04]
{@Margo}    Why don’t you go ahead and name him?    $[Day2/Rookery/2rm05]
{@Player}   Okay, let’s see. Alfredo and…. um….how about . . . $[Day2/Rookery/Player_6]
{@Player}    . . Meatball?  $[Day2/Rookery/Player_7]
{@Player}   Now I’m getting hungry. Got any candy bars in that case?    $[Day2/Rookery/Player_8]

$goto Day2.CheckAllMatesIdentified

:: OnDaisyIdentified
@trigger	TabletIdentified
@when		objectId == "Daisy"
@once
@interrupt

$set	chapter:identifiedCount + 1
$call CompleteGoal("id_fuzz")

{@Margo}    Hmm. Fuzz and Daisy. Interesting.   $[Day2/Rookery/2rm07]
{@Player}   What's interesting?  $[Day2/Rookery/Player_9]
{@Margo}    I just hope Fuzz is ready to be a parent. He’s so easily distracted.    $[Day2/Rookery/2rm08]
{@Margo}    And it’s the first mating season for both of these penguins.    $[Day2/Rookery/2rm09]
{@Player}   I’m sure they’ll be fine. It’s instinct for them, right?    $[Day2/Rookery/Player_10]
{@Margo}    You’d be surprised, kid. Not all penguins make good parents.    $[Day2/Rookery/2rm10]
{@Player}   We’ll just have to wait and see.    $[Day2/Rookery/Player_11]

$goto Day2.CheckAllMatesIdentified

:: OnWendyIdentified
@trigger	TabletIdentified
@when		objectId == "Wendy"
@once
@interrupt

$set	chapter:identifiedCount + 1
$call CompleteGoal("id_winston")

{@Margo}    Aw, Winston and Wendy! I was hopin' they'd find each other again. $[Day2/Rookery/2rm11]
{@Margo}   They've had successful chicks every year. I keep worrying their luck's gonna run out, but so far, so good. $[Day2/Rookery/2rm12]

$goto Day2.CheckAllMatesIdentified

:: OnBenniIdentified
@trigger	TabletIdentified
@when		objectId == "Benni"
@once
@interrupt

$set	chapter:identifiedCount + 1
$call CompleteGoal("id_polo")

{@Margo}   Ooh, Benni and Polo! What a good match.  $[Day2/Rookery/2rm13]
{@Margo}   Polo is such a sweetie. I bet he'll make a great dad.  $[Day2/Rookery/2rm14]

$goto Day2.CheckAllMatesIdentified

::CheckAllComplete
@trigger CheckAllComplete
$if chapter:finishedObservations == true, chapter:finishedTrackers == true
	{@Margo}    Okay, that’s all the data we need!  $[Day2/Rookery/2rm25]
	{@Margo}    When you're ready we can head back to the research tent and analyze our data.   $[Day2/Rookery/2rm26]
	$call SetWarpActive(WarpBluffBack, true)
	$set chapter:finishedAllObservations = true
	$call CreateGoal("Day2_return", Return to tent)
$elseif chapter:finishedObservations == true, chapter:finishedTrackers == false
	$call CreateGoal("Day2_trackers", Retrieve 3 gps trackers from penguins)
	$call CreateGoal("Day2_mates", Identify the mates of the banded penguins)
	$call CompleteGoal("Day2_mates")
$elseif chapter:finishedObservations == false, chapter:finishedTrackers == true
	$call CreateGoal("Day2_trackers", Retrieve 3 gps trackers from penguins)
	$call CompleteGoal("Day2_trackers")
	$call CreateGoal("Day2_mates", Identify the mates of the banded penguins)
$endif

:: CheckAllMatesIdentified
@trigger    CheckAllMatesIdentified
$if chapter:identifiedCount >= 5 
    $set	chapter:finishedObservations = true
    $call ClearGoals()
	$call TriggerResponse(CheckAllComplete)
$endif

:: WarpedToRookeryGate2
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-RookeryFar"
@once

$call Wait(2)

$call FuzzLegTracker->Activate()
$call AlfredoLegTracker->Activate()
$call WinstonLegTracker->Activate()
$call MillieLegTracker->Activate()
$call PoloLegTracker->Activate()
$call AdelieLegTracker1->Activate()
$call AdelieLegTracker2->Activate()

//show the trackers visible on several penguins...
$call SocketObjectTo(FuzzLegTracker, FuzzLegSocket)
$call SocketObjectTo(AlfredoLegTracker, AlfredoLegSocket)
$call SocketObjectTo(WinstonLegTracker, WinstonLegSocket)
$call SocketObjectTo(MillieLegTracker, MillieLegSocket)
$call SocketObjectTo(PoloLegTracker, PoloLegSocket)
$call SocketObjectTo(AdelieLegTracker1, AdelieLegSocket1)
$call SocketObjectTo(AdelieLegTracker2, AdelieLegSocket2)


{@Margo}    Okay, kid. This is the tricky part. You’ll need to remove each penguin’s GPS tracker. $[Day2/Rookery/2rm15]
{@Margo}    Place one hand on a penguin to hold it still.    $[Day2/Rookery/2rm16]
{@Margo}    Then use your other hand to grab the tracker from its leg.   $[Day2/Rookery/2rm17]
{@Margo}   And release it near the Pelican Case to drop it inside.   $[Day2/Rookery/2rm18]
{@Player}   Got it. No problem. $[Day2/Rookery/Player_12]
{@Margo}    Just watch out for their beaks. $[Day2/Rookery/2rm19]
{@Margo}    These little sweeties might look harmless, but they'll nip ya when they feel threatened.    $[Day2/Rookery/2rm20]
{@Margo}    And they've got a mean bite.    $[Day2/Rookery/2rm21]

::OnFuzzTrackerRemoved
@trigger TrackerRemoved
@when   objectId == "FuzzLegTracker"
@once

{@Player}   Ouch! Fuzz, just hold still!    $[Day2/Rookery/Player_14]

:: OnPenguinLegTrackerSocketed
@trigger	ObjectSocketed
@when		objectType == "LegTracker", socketType == "CaseLegSocket"
$set	chapter:removedCount + 1

$if chapter:removedCount >= 3
	$call TriggerResponse(TrackersCompleted)
$endif

:: OnPenguinLegTrackerUnsocketed
@trigger	ObjectUnsocketed
@when		objectType == "LegTracker", socketType == "CaseLegSocket"
$set	chapter:removedCount - 1

:: TrackersCompleted
@trigger	TrackersCompleted
@who		Player
@interrupt

$set chapter:finishedTrackers = true
$call ClearGoals()

$call Wait(0.3)
{@Margo}  Nice work, kid! That’s all the GPS trackers.   $[Day2/Rookery/2rm24]

$call TriggerResponse(CheckAllComplete)

:: WarpedBackToTent2
@trigger    AtWarpPoint
@who        Player
@when       chapter:finishedAllObservations, targetObject == "WarpTarget-Bluff-Back"
@once

$call Wait(1)
$call TentDoor->Open()
$call SetWarpActive(WarpBluffBack, false)
$call SetWarpGroupActive(Rookery, false)
$call SetWarpActive(WarpDesk, true)

$call CreateGoal("Day2_upload", Dock Margo to upload data)

:: WarpedInsideTent2
@trigger    AtWarpPoint
@who        Player
@when       chapter:finishedAllObservations, targetObject == "WarpTarget-Desk"
@interrupt

$call TentDoor->Close()
$call CompleteGoal("Day2_return")
$call Wait(1)
$call SetWarpActive(WarpDesk, true)

{@Margo}    Okay dokey! Just dock me in the port there, and I’ll take a look at our data. $[Day2/Tent/2tm9]

$while !IsSocketedBy(DeskDock, Margo)
$call Wait(0.5)
$endwhile

$while !ButtonPressed(BigButton)
$call Wait(0.5)
$endwhile

$call CompleteGoal("Day2_upload")

{@Margo}    Looks like the population has increased as more penguins show up for mating season.    $[Day2/Tent/2tm10]
{@Margo}    All five of your penguins have formed breeding pairs!    $[Day2/Tent/2tm11]
{@Margo}    Most penguin parents lay two eggs each season . . . but not all of them end up hatching.    $[Day2/Tent/2tm12]
{@Margo}    We'll have to wait and see what happens.    $[Day2/Tent/2tm13]
{@Margo}    Nice job, kid. Another excellent day's work.    $[Day2/Tent/2tm14]
{@Margo}    And you've still got plenty of time for trick or treating!  $[Day2/Tent/2tm15]
{@Margo}    There's a costume parade at McMurdo Station. I'm going as a vintage TV. Penny got me an antenna and everything! $[Day2/Tent/2tm16]
{@Player}   I think I'll stay here. I checked out a copy of The Thing from the library. $[Day2/Tent/Player_6]
{@Margo}    Yikes. Do you, uh... know what it's about? $[Day2/Tent/2tm17]
{@Player}   Not really, but I've heard it's pretty spooky.  $[Day2/Tent/Player_7]
{@Margo}    Yeah, ya got that right.    $[Day2/Tent/2tm18]
{@Margo}    You better stock up on more candy... I don't think you'll be gettin' much sleep tonight.    $[Day2/Tent/2tm19]

//$call FadeOut(1.0)
$call Wait(2)

$call LoadNextDay()