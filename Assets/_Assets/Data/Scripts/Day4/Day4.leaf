#basePath	Day4

:: Prepare
@function	ScenePrepare
$set chapter:finishedObservations = false
$set chapter:identifiedCount = 0
$call ClearGoals()
$call PlaceAndRotatePlayerAt(WarpDesk, true)
$call SetAllWarpsActive(false)
$call Sky3->Deactivate()
$call Sky4->Activate()
$call Sky4->SetSkybox()
$call Ocean->SetMaterial(3);
$call Terrain->SetTerrainMaterial(3);

$call DayHeader->SetText(Dec 18)
$call FadeIn(2.0)
$call Wait(2)

:: StartGame
@trigger    SceneReady
@who        Player
@once

$call SetWarpActive(WarpBluff, true)

{@Margo}   Mornin', kiddo.   $[Day4/Tent/4tm01]
{@Player}   Whoa… what’s all this?   $[Day4/Tent/Player_1]
{@Margo}   Penny got up early to decorate. It’s one week til Christmas!  $[Day4/Tent/4tm02]
{@Margo}    Sorry, no presents yet…. Santa usually shows up a little late here. $[Day4/Tent/4tm03]
{@Player}   Yeah. I guess we’re about as far from the North Pole as you can get.  $[Day4/Tent/Player_2]
{@Player}   I wish Lola could meet the Fliptastic Five for Christmas. She’d love them!     $[Day4/Tent/Player_3]
{@Player}   Especially Polo.    $[Day4/Tent/Player_4]
{@Margo}   Aw, cheer up, kiddo. You’ll see Lola again before ya know it!     $[Day4/Tent/4tm04]
{@Margo}    What’s she doin’ today, do ya think?    $[Day4/Tent/4tm05]
{@Player}   She’s a sixth-grade teacher and it’s the last day before winter break.  $[Day4/Tent/Player_5]
{@Player}   So they’re probably… I don’t know. Eating cookies and making ornaments out of noodles?  $[Day4/Tent/Player_6]
{@Margo}    For a human, you don’t know too much about human kids, do ya?   $[Day4/Tent/4tm06]
{@Player}   Guess not.  $[Day4/Tent/Player_7]
{@Margo}    Well, at least you’re becomin’ an expert on penguin kids.   $[Day4/Tent/4tm07]
{@Margo}    Come on. Let’s get out there and check on those penguins.   $[Day4/Tent/4tm08]

$call Wait(1)

:: WarpedOutsideTent
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-Bluff"
@interrupt
@once

$call TentDoor->Close()

$call Wait(1)

$call SetWarpActive(WarpBluff, false)

$call SetWarpGroupActive(Rookery, true)

:: WarpedToRookery
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-Rookery"
@once

$call Wait(1)

$call SetWarpGroupActive(Rookery, true)

{@Player}   Whoa… look at them! I keep forgetting how funny the chicks look these days. $[Day4/Rookery/Player_1]
{@Partner}   Isn’t it great? We call this their awkward-teenager stage. $[Day4/Rookery/Partner_1]
{@Player}   How’s Polo’s chick doing?   $[Day4/Rookery/Player_2]
{@Partner}  Seems fine. A little small for her age, but she’s a tough cookie.   $[Day4/Rookery/Partner_2]
{@Player}   Phew. That’s good. I was rooting for her.   $[Day4/Rookery/Player_3]
{@Player}   Oh, and speaking of cookies . . . where’d you get all that Christmas stuff? $[Day4/Rookery/Player_4]
{@Partner}  Oh, did you like it? It’s no biggie, just some old decorations I had lying around.  $[Day4/Rookery/Partner_3]
{@Player}   At the South Pole?? How?    $[Day4/Rookery/Player_5]
{@Partner}  I won most of it in a cribbage game at McMurdo. $[Day4/Rookery/Partner_4]
{@Player}   Oh. Yeah… that tracks.  $[Day4/Rookery/Player_6]
{@Margo}    Okay, enough chatter. Lots to do today. $[Day4/Rookery/4rm01]
{@Margo}    You’ll need to collect data from the weigh bridge—that’s that gate doohickey over there. $[Day4/Rookery/4rm02]
{@Margo}    We also need to get the data loggers from the penguins you tagged back at Thanksgiving. $[Day4/Rookery/4rm03]
{@Margo}    And we’ll need to band 3 of the chicks. $[Day4/Rookery/4rm04]
{@Player}   Got it. Let’s get to work.  $[Day4/Rookery/Player_7]

:: WarpedToRookeryGate
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-RookeryFar"
@once
@interrupt

$call WeighGate->SetInteractable(true)

{@Player}    Okay, Margo. How does this weigh bridge thing work, exactly? $[Day4/Rookery/Player_8]
{@Margo}    Oh, it’s easy as pie!    $[Day4/Rookery/4rm05]
{@Margo}    The weigh bridge gathers data on what the penguins were up to when they were away from the colony.   $[Day4/Rookery/4rm06]
{@Margo}    You know . . . where they went, what they were eatin’, stuff like that.   $[Day4/Rookery/4rm07]
{@Margo}   Just make sure Scan Mode is on, and then point me at the gate. $[Day4/Rookery/4rm08]
{@Margo}    I’ll scan each penguin’s data as it passes through. $[Day4/Rookery/4rm09]

:: OnWeighGateIdentified
@function	TabletIdentified
@when		objectId == "WeighGate"

$call CompleteGoal("day4_gate")
$set	chapter:weighGate = true
$goto Day4.CheckCompletedTasks

:: WarpedToRookeryMiddle
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-RookeryMiddle"
@interrupt

$call DataLoggerPlate->Activate()
$call GPSSocketRight->Activate()
$call GPSSocketMiddle->Activate()
$call GPSSocketLeft->Activate()
$call ChickBandPlate->Deactivate()
$call BandSocketRight->Deactivate()
$call BandSocketMiddle->Deactivate()
$call BandSocketLeft->Deactivate()
$call WingBand1->Deactivate()
$call WingBand2->Deactivate()
$call WingBand3->Deactivate()

$call SocketObjectTo(DataTrackerBack1, DataSocketBack1)
$call SocketObjectTo(DataTrackerBack2, DataSocketBack2)
$call SocketObjectTo(DataTrackerBack3, DataSocketBack3)
$call SocketObjectTo(DataTrackerBack4, DataSocketBack4)
$call SocketObjectTo(DataTrackerBack5, DataSocketBack5)

$call DataTrackerBack1->SetMeshEnabled(true)
$call DataTrackerBack2->SetMeshEnabled(true)
$call DataTrackerBack3->SetMeshEnabled(true)
$call DataTrackerBack4->SetMeshEnabled(true)
$call DataTrackerBack5->SetMeshEnabled(true)

{@Margo}    Wahoo! Looks like all the penguins with data loggers have come back.    $[Day4/Rookery/4rm10]
{@Margo}    Now we’ll be able to get the stats on their swimming behaviors!     $[Day4/Rookery/4rm11]
{@Margo}    Just hold the penguin still with one hand and remove their trackers.    $[Day4/Rookery/4rm12]
{@Margo}    Then drop the tracker into the Pelican Case.    $[Day4/Rookery/4rm13]

:: OnSocketedTracker
@trigger    ObjectSocketed
@when   objectType == "DataTracker", socketType == "TrackerSocket"
$set chapter:dataCount + 1
$goto Day4.CheckDataCount

:: CheckDataCount
@trigger    CheckDataCount
@who    Player

$if chapter:dataCount >= 3
$set chapter:dataTrackersDone = true
$goto Day4.CheckCompletedTasks
$endif

:: WarpedToRookeryCorral
@trigger    AtWarpPoint
@who        Player
@when       targetObject == "WarpTarget-RookeryCorral"
@interrupt

$call DataLoggerPlate->Deactivate()
$call GPSSocketRight->Deactivate()
$call GPSSocketMiddle->Deactivate()
$call GPSSocketLeft->Deactivate()
$call DataTrackerBack1->SetMeshEnabled(false)
$call DataTrackerBack2->SetMeshEnabled(false)
$call DataTrackerBack3->SetMeshEnabled(false)
$call DataTrackerBack4->SetMeshEnabled(false)
$call DataTrackerBack5->SetMeshEnabled(false)

$call ChickBandPlate->Activate()
$call BandSocketRight->Activate()
$call BandSocketMiddle->Activate()
$call BandSocketLeft->Activate()

$call WingBand1->Activate()
$call WingBand2->Activate()
$call WingBand3->Activate()

$call SocketObjectTo(WingBand1, BandSocketRight)
$call SocketObjectTo(WingBand2, BandSocketMiddle)
$call SocketObjectTo(WingBand3, BandSocketLeft)

$set chapter:wingCount = 0

{@Margo}    Okay, kiddo. Time to band the chicks.   $[Day4/Rookery/4rm14]
{@Margo}    Fair warning… This job isn’t for the faint of heart.    $[Day4/Rookery/4rm15]
{@Player}    Oh, come on. They're, like, half the size of the grown-ups. How hard can it be?    $[Day4/Rookery/Player_9]
{@Margo}    Haven’t you been paying attention for the last three months??   $[Day4/Rookery/4rm16]
{@Margo}    They’re cuties, but they’re tougher than they look. $[Day4/Rookery/4rm17]
{@Margo}    “Though she be but little . . . ”   $[Day4/Rookery/4rm18]
{@Player}   Okay, okay, I get it. I'll be careful.  $[Day4/Rookery/Player_10]
{@Player}   What do I need to do?   $[Day4/Rookery/Player_11]
{@Margo}    First you’ll need to hold the penguin in place. $[Day4/Rookery/4rm19]
{@Margo}    Then grab a wing band from the case and attach it to the penguin’s right wing.  $[Day4/Rookery/4rm20]
{@Player}   Cool, no sweat. $[Day4/Rookery/Player_12]  

:: OnUnsocketedWingBand
@trigger ObjectSocketed
@when   objectType == "WingBand", socketType == "BandSocket"
$set chapter:wingCount - 1

:: OnSocketedWingBand
@trigger ObjectSocketed
@when   objectType == "WingBand", socketType == "BandSocket"
$set chapter:wingCount + 1

$if chapter:wingCount == 1
{@Player}   Jeez! Ouch! Would you just—hold—still?  $[Day4/Rookery/Player_13]
$elseif chapter:wingCount == 2
{@Player}   Yikes. This little guy is not happy.    $[Day4/Rookery/Player_14]
{@Player}   I promise, I’m not gonna hurt you! It’s just like a hair clip. Totally harmless.    $[Day4/Rookery/Player_15]
{@Player}   Ouch!    $[Day4/Rookery/Player_16]
{@Margo}    No sweat, huh, kiddo?   $[Day4/Rookery/4rm21]
{@Player}   Okay, okay . . . maybe a little sweat.  $[Day4/Rookery/Player_17]
$elseif chapter:wingCount == 3
$set chapter:finishedBands = true
{@Margo}   Okey dokey, that’s everything we need!    $[Day4/Rookery/4rm22]
{@Partner}  Nice work, new kid. $[Day4/Rookery/Partner_5]
{@Partner}  If these penguins come back as adults, the tags will tell us who they are and when they were born. $[Day4/Rookery/Partner_6]
{@Player}   Whoa. What do you mean, if they come back?  $[Day4/Rookery/Player_18]
{@Partner}  Well, most penguin chicks don’t make it to adulthood. $[Day4/Rookery/Partner_7]
{@Player}   What!?  $[Day4/Rookery/Player_19]
{@Partner}  It’s a rough world out there for penguins. The skua are only the tip of the iceberg.    $[Day4/Rookery/Partner_8]
{@Partner}  There’s hungry leopard seals, snow storms, melting sea ice . . .    $[Day4/Rookery/Partner_9]
{@Player}   Oookay. I just lost my Christmas spirit.    $[Day4/Rookery/Player_20]
{@Player}   I guess that’s why you and Margo have such a thick skin. You’re used to it by now.  $[Day4/Rookery/Player_21]
{@Partner}  Me?? A thick skin?  $[Day4/Rookery/Partner_11]
{@Player}   I mean… none of it seems to bother you. $[Day4/Rookery/Player_22]
{@Partner}  Oh, trust me, it bothers me. Those skua drive me crazy. $[Day4/Rookery/Partner_12]
{@Partner}  And some of the parents just can’t seem to figure out how to feed their chicks. $[Day4/Rookery/Partner_13]
{@Partner}  I’ve been here twenty years, and it’s still hard to watch sometimes.    $[Day4/Rookery/Partner_14]
{@Player}   Do you ever try to help them?   $[Day4/Rookery/Player_23]
{@Partner}  Well, that’s not really my job. I mean, where am I gonna find krill?    $[Day4/Rookery/Partner_15]
{@Partner}  The fact is, we’re not here to rescue penguin chicks.   $[Day4/Rookery/Partner_16]
{@Partner}  We’re here to learn about them, and to teach other people about them.   $[Day4/Rookery/Partner_17]
{@Partner}  Plus I just love this work. I love these birds   $[Day4/Rookery/Partner_18]
{@Player}   Yeah. You’re right. $[Day4/Rookery/Player_24]
{@Player}   But I still wish there was more I could do. $[Day4/Rookery/Player_25]
{@Partner}  Aw, don’t look so down, new kid.    $[Day4/Rookery/Partner_19]
$goto Day4.CheckCompletedTasks
$endif

:: CheckCompletedTasks
@trigger	CheckCompletedTasks
@who		Player

$if chapter:finishedBands == true, chapter:dataTrackersDone == true, chapter:weighGate == true 
$set chapter:finishedObservations = true
$call Wait(0.3)
$call SetWarpActive(WarpBluffBack, true)
{@Partner}  Why don’t you head back to the tent?    $[Day4/Rookery/Partner_20]
{@Partner}  You and Margo need to analyze your data. And then we’ve got a little surprise for you.  $[Day4/Rookery/Partner_21]

$endif

:: WarpedBackToTent
@trigger    AtWarpPoint
@who        Player
@when       chapter:finishedObservations, targetObject == "WarpTarget-Bluff-Back"
@once
@interrupt

$call Wait(1)
$call TentDoor->Open()
$call SetWarpActive(WarpBluffBack, false)
$call SetWarpGroupActive(Rookery, false)
$call SetWarpActive(WarpDesk, true)

:: WarpedInsideTent
@trigger    AtWarpPoint
@who        Player
@when       chapter:finishedObservations, targetObject == "WarpTarget-Desk"
@interrupt

$call TentDoor->Close()
$call Wait(1)
$call SetWarpActive(WarpDesk, true)

{@Margo}    Okey dokey, let’s have a look at that data! $[Day4/Tent/4tm09]

$while !IsSocketedBy(DeskDock, Margo)
$call Wait(0.5)
$endwhile

$while !ButtonPressed(BigButton)
$call Wait(0.5)
$endwhile

{@Player}   Awesome! Thanks, Margo. $[Day4/Tent/Player_8]
{@Margo}    Hang on a sec, kiddo.   $[Day4/Tent/4tm13]
{@Margo}    There’s still one more thing. Did you forget about the surprise?    $[Day4/Tent/4tm14]
{@Player}   Yikes… it’s not a pumpkin pie to the face, is it?   $[Day4/Tent/Player_9]
{@Player}   Because I already told Penny I was sorry back at Thanksgiving $[Day4/Tent/Player_10]
{@Margo}  Nope. It’s not a pie, in your face or otherwise.  $[Day4/Tent/4tm15]
{@Margo}    Penny and I made a couple phone calls while you were sleepin’.  $[Day4/Tent/4tm16]
{@Margo}    Let’s see if we can get connected…. $[Day4/Tent/4tm17]
{@Player}   Lola!   $[Day4/Tent/Player_11]
{@Lola}     Hola, mi amor. How’s Christmas at the South Pole?   $[Day4/Tent/Lola_1]
{@Player}   A lot better now! What are you doing here?  $[Day4/Tent/Player_12]
{@Lola}     Well… of course I wanted to see you.    $[Day4/Tent/Lola_2]
{@Lola}     But also… we’ve been learning all about penguin adaptations, and your friend Penny said that you do virtual classroom visits.    $[Day4/Tent/Lola_3]
{@Lola}     Do you think my students and I could get in on that?    $[Day4/Tent/Lola_4]
{@Player}   Claro que si!   $[Day4/Tent/Player_13]
{@Player}   Are you ready for the grand tour? I’ve got these five new friends I think you’re going to love. $[Day4/Tent/Player_14]

//$call FadeOut(1.0)
$call Wait(2)

$call LoadNextDay()