#basePath   Starting

:: Starting
@trigger   SceneReady

$call GameStart->Activate()
$call PennycookSurvey->Deactivate()
$call FadeIn(4.0)
$call PlaceAndRotatePlayerAt(WarpDesk, true)
$call SetAllWarpsActive(false)

//$call uplinkButton->ShowHighlight()
//$call uplinkButton->PlayFX()

$call BigButton->SetButtonPressed(false)

$set chapter:cv = GetCulturalVersion(true)

$while !ButtonPressed(BigButton)
$call Wait(0.5)
$endwhile

//$call uplinkButton->StopHighlight()
//$call uplinkButton->StopFX()
$call GameStart->AssignCode()
$call BigButton->SetButtonPressed(false)

$call FadeOut(4.0)
$call Wait(4)

//$call menu->SetDisabled(true)

$call LoadNextDay()